packages:
  @DEPS@/kes-agent-1.2.0.0
  @DEPS@/cardano-crypto-1.3.0
  @DEPS@/cardano-prelude-0.2.2.0
  @DEPS@/plutus-core-1.63.0.0
  @APP@
  @DEPS@/foundation-0.0.30
  @DEPS@/ouroboros-consensus-3.0.1.0
  @DEPS@/cardano-api-11.0.0.0
  @DEPS@/cardano-crypto-class-2.5.0.0
  @DEPS@/cardano-crypto-praos-2.2.2.0
  @DEPS@/basement
  @DEPS@/double-conversion-2.0.5.0
  @DEPS@/network
  @DEPS@/ram
  @DEPS@/libsodium-clib
  @DEPS@/cborg-wasi
  @DEPS@/memory-0.18.0
  @DEPS@/cryptonite-0.30
  @DEPS@/crypton-1.0.6

package secp256k1-clib
  flags: +schnorrsig +recovery +ecdh +extrakeys

package cardano-crypto-class
  flags: -external-libsodium-vrf

package cardano-crypto-praos
  flags: -external-libsodium-vrf

package sodium-clib
  configure-options: --enable-pie=no

package plutus-core
  flags: +do-not-build-plutus-exec

package plutus-tx-plugin
  profiling: False

package plutarch
  ghc-options: -Wwarn

package plutarch-ledger-api
  ghc-options: -Wwarn

tests: False
benchmarks: False
documentation: False
write-ghc-environment-files: never

constraints: plutus-core ==1.63.0.0, plutus-ledger-api ==1.63.0.0, plutus-tx ==1.63.0.0

allow-newer: *:cardano-crypto-class, *:cardano-crypto-praos
constraints: ouroboros-consensus ==3.0.1.0


allow-newer: cardano-api:plutus-core, cardano-api:plutus-ledger-api

constraints: contra-tracer ==0.1.0.2
